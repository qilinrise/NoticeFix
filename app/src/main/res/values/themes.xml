<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础应用主题：全面升级为 Material 3 -->
    <style name="Theme.NoticeFix" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 沉浸式透明状态栏与导航栏 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- 保留项目原本引用的 NoActionBar 主题 -->
    <style name="Theme.NoticeFix.NoActionBar" parent="Theme.NoticeFix">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 顶栏与弹窗样式升级为 Material 3 -->
    <style name="Theme.NoticeFix.AppBarOverlay" parent="ThemeOverlay.Material3.Toolbar.Surface" />
    <style name="Theme.NoticeFix.PopupOverlay" parent="ThemeOverlay.Material3" />
</resources>
