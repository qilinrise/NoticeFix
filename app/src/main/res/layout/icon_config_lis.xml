<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- 修复：ID 对齐代码中的 icon_config_content_order -->
    <ImageView
        android:id="@+id/icon_config_content_order"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_drag_handle"
        app:tint="?android:attr/textColorSecondary" />

    <!-- 修复：ID 对齐代码中的 icon_config_content -->
    <TextView
        android:id="@+id/icon_config_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp" />

    <!-- 修复：ID 对齐代码中的 icon_config_switchCompat -->
    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/icon_config_switchCompat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
